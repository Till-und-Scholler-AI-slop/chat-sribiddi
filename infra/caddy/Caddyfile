germinai.de {
  encode zstd gzip

  # Backend API and OAuth endpoints go through /api.
  handle_path /api/* {
    reverse_proxy 127.0.0.1:8080
  }

  # OAuth callback from Google (Spring Security default redirect endpoint).
  handle /login/oauth2/* {
    reverse_proxy 127.0.0.1:8080
  }

  # Optional direct OAuth authorization entrypoint (without /api prefix).
  handle /oauth2/* {
    reverse_proxy 127.0.0.1:8080
  }

  # Frontend app (Nuxt).
  handle {
    reverse_proxy 127.0.0.1:3000
  }
}
