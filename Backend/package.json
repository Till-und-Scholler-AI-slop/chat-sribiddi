    "db:migrate": "docker compose run --rm flyway"
  },
  "dependencies": {
    "@chat-sribiddi/provider-contract": "file:../packages/provider-contract",
    "@ai-sdk/anthropic": "^3.0.81",
    "@ai-sdk/google": "^3.0.80",
    "@ai-sdk/openai": "^3.0.68",
    "@ai-sdk/openai-compatible": "^2.0.48",
    "@hono/node-server": "^2.0.4",
    "@hono/zod-openapi": "^1.4.0",
    "ai": "^6.0.197",
    "dotenv": "^17.2.3",
    "hono": "^4.12.23",
    "ioredis": "^5.8.2",
    "jose": "^6.1.3",
    "kysely": "^0.29.2",
    "pdf-parse": "^2.4.5",
    "pino": "^10.1.0",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "yaml": "^2.8.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@testcontainers/postgresql": "^12.0.1",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@vitest/coverage-v8": "^4.1.8",
    "testcontainers": "^12.0.1",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
