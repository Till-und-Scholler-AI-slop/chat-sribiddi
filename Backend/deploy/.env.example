NODE_ENV=production
PORT=8080
HOST=0.0.0.0

POSTGRES_DB=chat_sribiddi
POSTGRES_USER=chat_sribiddi
POSTGRES_PASSWORD=change-me

# Deployment must use the immutable image produced by CI (sha-<git-sha>).
IMAGE_TAG=sha-change-me

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Model-provider OAuth. Defaults to GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET when blank.
GOOGLE_PROVIDER_OAUTH_ENABLED=true
GOOGLE_PROVIDER_OAUTH_CLIENT_ID=
GOOGLE_PROVIDER_OAUTH_CLIENT_SECRET=
GOOGLE_PROVIDER_OAUTH_USER_PROJECT=
GOOGLE_PROVIDER_OAUTH_AUTHORIZATION_URI=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_PROVIDER_OAUTH_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_PROVIDER_OAUTH_SCOPES=https://www.googleapis.com/auth/cloud-platform,https://www.googleapis.com/auth/generative-language.retriever

# Optional provider device-code flow for the GitHub Copilot profile in Settings.
# Requires an officially registered GitHub OAuth app that allows device flow.
GITHUB_COPILOT_OAUTH_CLIENT_ID=
GITHUB_COPILOT_OAUTH_SCOPES=read:user
GITHUB_COPILOT_DEVICE_CODE_URI=https://github.com/login/device/code
GITHUB_COPILOT_ACCESS_TOKEN_URI=https://github.com/login/oauth/access_token

PROVIDER_GATEWAY_ENABLED=true
PROVIDER_GATEWAY_BASE_URL=http://provider-gateway:8095
PROVIDER_GATEWAY_SHARED_SECRET=
# Staged rollout: openrouter -> native APIs -> openai-compatible -> CLI.
# Supported keys: openrouter,openai,anthropic,google,openai-compatible,codex,grok-cli,all
PROVIDER_GATEWAY_PROVIDERS=openrouter
METRICS_TOKEN=

# Hosted beta: lets users connect their own ChatGPT/Codex subscription through
# `codex login --device-auth`. The production images install the Codex CLI and
# store per-user CODEX_HOME data in the private codex-connections volume.
OPENAI_CODEX_SUBSCRIPTION_ENABLED=true
# Optional override. Leave blank to use the first visible model from `codex debug models`.
OPENAI_CODEX_SUBSCRIPTION_MODEL=
CODEX_CLI_BINARY=codex
CODEX_CONNECTIONS_ROOT=/var/lib/chat-sribiddi/codex-connections
CODEX_DEVICE_AUTH_START_TIMEOUT_MS=15000
CODEX_EXEC_TIMEOUT_MS=300000

# Hosted beta: lets users connect their own xAI/Grok Build account through the
# official Grok CLI bridge. The backend never uses a shared xAI subscription.
GROK_CLI_ENABLED=true
GROK_CLI_BIN=grok
GROK_CLI_SESSIONS_DIR=/var/lib/chat-sribiddi/grok-sessions
GROK_CLI_LOGIN_PROMPT_TIMEOUT_MS=15000
GROK_CLI_LOGIN_TOTAL_TIMEOUT_MS=300000
GROK_CLI_REQUEST_TIMEOUT_MS=120000
GROK_CLI_MAX_OUTPUT_BYTES=1048576
GROK_CLI_MAX_CONCURRENT_PER_USER=1

OPENROUTER_API_KEY=
OPENROUTER_APP_NAME=chat-sribiddi
OPENROUTER_REFERRER=https://germinai.de

APP_FRONTEND_URL=https://germinai.de
ALLOWED_ORIGINS=https://germinai.de

# Auth sessions are intentionally persistent so users are not logged out during normal use.
SESSION_TIMEOUT=30d
SESSION_COOKIE_MAX_AGE=30d

# Redis (override only if running Redis outside docker-compose)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Request limits are DDoS-oriented. Redis-backed limiting fails closed in production.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_ANONYMOUS_PER_MINUTE=300
RATE_LIMIT_AUTHENTICATED_PER_MINUTE=600
RATE_LIMIT_TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12
GUEST_OPENROUTER_FREE_DAILY_CAP=20

CHAT_STREAM_TIMEOUT_MS=1800000
CHAT_STREAM_HEARTBEAT_MS=15000
SHUTDOWN_GRACE_MS=60000
CHAT_MAX_DOCUMENT_BYTES=6291456

# Monitoring is private to the Docker network; Grafana is exposed only on
# 127.0.0.1:3001 and is intended to be reached through an SSH tunnel.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# 8 GB VPS defaults leave at least 2 GB for the host and Caddy. Override only
# after observing steady-state RSS and pool pressure.
POSTGRES_MEMORY_LIMIT=1536m
REDIS_MEMORY_LIMIT=384m
FLYWAY_MEMORY_LIMIT=256m
BACKEND_MEMORY_LIMIT=1024m
PROVIDER_GATEWAY_MEMORY_LIMIT=1536m
PROMETHEUS_MEMORY_LIMIT=768m
ALERTMANAGER_MEMORY_LIMIT=128m
GRAFANA_MEMORY_LIMIT=512m

# Generate with: openssl rand -base64 32
ENCRYPTION_SECRET=
SESSION_SECRET=
ENCRYPTION_ACTIVE_KEY_VERSION=1
ENCRYPTION_DECRYPTION_SECRETS=
