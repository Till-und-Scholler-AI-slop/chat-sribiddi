NODE_ENV=production
PORT=8080
HOST=0.0.0.0

POSTGRES_DB=chat_sribiddi
POSTGRES_USER=chat_sribiddi
POSTGRES_PASSWORD=change-me

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Model-provider OAuth. Defaults to GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET when blank.
GOOGLE_PROVIDER_OAUTH_ENABLED=true
GOOGLE_PROVIDER_OAUTH_CLIENT_ID=
GOOGLE_PROVIDER_OAUTH_CLIENT_SECRET=
GOOGLE_PROVIDER_OAUTH_USER_PROJECT=
GOOGLE_PROVIDER_OAUTH_AUTHORIZATION_URI=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_PROVIDER_OAUTH_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_PROVIDER_OAUTH_SCOPES=https://www.googleapis.com/auth/cloud-platform,https://www.googleapis.com/auth/generative-language.retriever

PROVIDER_GATEWAY_ENABLED=false
PROVIDER_GATEWAY_BASE_URL=http://provider-gateway:8095

OPENROUTER_API_KEY=
OPENROUTER_APP_NAME=chat-sribiddi
OPENROUTER_REFERRER=https://germinai.de

APP_FRONTEND_URL=https://germinai.de
ALLOWED_ORIGINS=https://germinai.de

# Auth sessions are intentionally persistent so users are not logged out during normal use.
SESSION_TIMEOUT=30d
SESSION_COOKIE_MAX_AGE=30d

# Redis (override only if running Redis outside docker-compose)
# REDIS_HOST=redis
# REDIS_PORT=6379

# Request limits are DDoS-oriented. Redis-backed limiting fails closed in production.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_ANONYMOUS_PER_MINUTE=300
RATE_LIMIT_AUTHENTICATED_PER_MINUTE=600
GUEST_OPENROUTER_FREE_DAILY_CAP=20

# Generate with: openssl rand -base64 32
ENCRYPTION_SECRET=
SESSION_SECRET=
ENCRYPTION_ACTIVE_KEY_VERSION=1
ENCRYPTION_DECRYPTION_SECRETS=
