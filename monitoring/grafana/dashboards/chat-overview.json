{
  "title": "Chat Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per minute",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (route, status) (rate(chat_http_requests_total[1m]) * 60)",
          "legendFormat": "{{route}} {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active streams",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "chat_active_streams",
          "legendFormat": "streams"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Token usage",
      "gridPos": { "h": 8, "w": 18, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum by (provider, type) (rate(chat_tokens_total[5m]))",
          "legendFormat": "{{provider}} {{type}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Error rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(chat_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(chat_http_requests_total[5m])), 0.001)",
          "legendFormat": "error ratio"
        }
      ]
    },
    {
      "id": 5,
      "type": "barchart",
      "title": "Requests by provider",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum by (provider, status) (increase(chat_provider_requests_total[1h]))",
          "legendFormat": "{{provider}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Stream duration average",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "sum by (provider) (rate(chat_stream_duration_seconds_sum[5m])) / clamp_min(sum by (provider) (rate(chat_stream_duration_seconds_count[5m])), 1)",
          "legendFormat": "{{provider}} avg"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "p95 time to first token",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, provider) (rate(chat_stream_ttft_seconds_bucket[10m])))",
          "legendFormat": "{{provider}} p95"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "PostgreSQL pool",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "targets": [
        {
          "expr": "chat_db_pool_connections",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Event-loop lag p99",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "targets": [
        {
          "expr": "chat_sribiddi_nodejs_eventloop_lag_p99_seconds",
          "legendFormat": "backend"
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Redis available",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 40 },
      "targets": [
        {
          "expr": "chat_redis_available",
          "legendFormat": "redis"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Gateway streams",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 40 },
      "targets": [
        {
          "expr": "sum by (provider, outcome) (rate(provider_gateway_streams_total[5m]))",
          "legendFormat": "{{provider}} {{outcome}}"
        }
      ]
    }
  ]
}
