{
  "title": "Chat Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per minute",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (provider, status) (rate(chat_requests_total[1m]) * 60)",
          "legendFormat": "{{provider}} {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active streams",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "chat_active_streams",
          "legendFormat": "streams"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Token usage",
      "gridPos": { "h": 8, "w": 18, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum by (provider, type) (rate(chat_tokens_total[5m]))",
          "legendFormat": "{{provider}} {{type}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Error rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(chat_requests_total{status=\"error\"}[5m])) / clamp_min(sum(rate(chat_requests_total[5m])), 1)",
          "legendFormat": "error ratio"
        }
      ]
    },
    {
      "id": 5,
      "type": "barchart",
      "title": "Requests by provider",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum by (provider) (increase(chat_requests_total[1h]))",
          "legendFormat": "{{provider}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Stream duration average",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "sum by (provider) (rate(chat_stream_duration_seconds_sum[5m])) / clamp_min(sum by (provider) (rate(chat_stream_duration_seconds_count[5m])), 1)",
          "legendFormat": "{{provider}} avg"
        }
      ]
    }
  ]
}
