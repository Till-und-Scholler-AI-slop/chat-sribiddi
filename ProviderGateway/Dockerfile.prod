# Build from the repository root:
# docker build -f ProviderGateway/Dockerfile.prod .
FROM node:22-bookworm-slim AS deps
WORKDIR /workspace

COPY packages/provider-contract/package.json packages/provider-contract/package-lock.json packages/provider-contract/index.js packages/provider-contract/index.d.ts ./packages/provider-contract/
COPY ProviderGateway/package.json ProviderGateway/package-lock.json ./ProviderGateway/
WORKDIR /workspace/ProviderGateway
RUN npm ci --omit=dev --prefix /workspace/packages/provider-contract && npm ci

FROM deps AS build
COPY ProviderGateway/tsconfig.json ./
COPY ProviderGateway/src ./src
RUN npm run build

FROM deps AS production-deps
RUN npm prune --omit=dev && npm cache clean --force

FROM node:22-bookworm-slim AS runtime
WORKDIR /workspace/ProviderGateway

ENV NODE_ENV=production
ENV HOME=/home/appuser
ARG APP_UID=10001
ARG APP_GID=10001
ARG CODEX_CLI_VERSION=0.137.0
ARG GROK_CLI_VERSION=0.2.32

RUN groupadd --gid "${APP_GID}" appuser \
  && useradd --uid "${APP_UID}" --gid "${APP_GID}" --create-home --home-dir /home/appuser --shell /usr/sbin/nologin appuser

RUN npm install -g "@openai/codex@${CODEX_CLI_VERSION}" "@xai-official/grok@${GROK_CLI_VERSION}" \
  && npm cache clean --force

COPY --from=production-deps /workspace/ProviderGateway/node_modules ./node_modules
COPY --from=production-deps /workspace/packages/provider-contract ../packages/provider-contract
COPY --from=build /workspace/ProviderGateway/dist ./dist
COPY ProviderGateway/package.json ./package.json

RUN chown -R appuser:appuser /workspace /home/appuser

USER appuser

EXPOSE 8095

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8095/health/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "dist/server.js"]
