FROM node:22-bookworm-slim AS deps
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

FROM deps AS build
COPY tsconfig.json ./
COPY src ./src
RUN npm run build

FROM node:22-bookworm-slim AS runtime
WORKDIR /app

ENV NODE_ENV=production
ENV HOME=/home/appuser
ARG APP_UID=10001
ARG APP_GID=10001
ARG CODEX_CLI_VERSION=0.137.0

RUN groupadd --gid "${APP_GID}" appuser \
  && useradd --uid "${APP_UID}" --gid "${APP_GID}" --create-home --home-dir /home/appuser --shell /usr/sbin/nologin appuser

COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

RUN npm install -g "@openai/codex@${CODEX_CLI_VERSION}" \
  && npm cache clean --force

COPY --from=build /app/dist ./dist

RUN chown -R appuser:appuser /app /home/appuser

USER appuser

EXPOSE 8095

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8095/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "dist/server.js"]
